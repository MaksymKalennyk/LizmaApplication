# Copy to .env and fill in. .env is read by docker-compose.yml and by Spring Boot
# (spring.config.import in application.properties), so no IDE env setup is needed.

# MySQL (docker compose publishes the container on this host port)
DB_PORT=3307
DB_NAME=lizma
DB_USERNAME=lizma
DB_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-too

# JWT signing key: Base64, at least 32 bytes. Generate with: openssl rand -base64 32
SECRET_KEY=

# Encrypts music service tokens in the database: Base64 of exactly 32 bytes (openssl rand -base64 32).
# Optional in development (a key is derived from SECRET_KEY), required in production. Keep it: changing it
# makes stored tokens unreadable and users have to reconnect Spotify.
ENCRYPTION_KEY=

# Moderators: usernames (comma-separated) that see Profile -> Moderation in the app.
ADMIN_USERNAMES=

# Moderation emails (optional). Gmail: MAIL_HOST=smtp.gmail.com, MAIL_USERNAME=lizma.support@gmail.com,
# MAIL_PASSWORD=an app password from the Google account (Security -> 2-Step Verification -> App passwords).
MAIL_HOST=
MAIL_USERNAME=
MAIL_PASSWORD=

# Exact Spotify links for posts (optional). song.link answers only with a key, given on request
# (odesli.co/help). Without one, "Open in Spotify" opens Spotify's search for the song.
ODESLI_API_KEY=

# Push notifications (optional until the paid Apple Developer account): Team ID (Membership), the APNs
# key's Key ID and the path to its .p8 file (Keys -> "+" -> Apple Push Notifications service). Keep the
# .p8 out of git (*.p8 is ignored). Without them notifications are only written to the server log.
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_KEY_PATH=
